# Normalise all text files to LF in the repository and in working copies.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never normalise line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.heic binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary

# Generated files: collapsed in GitHub diffs.
pnpm-lock.yaml linguist-generated=true
packages/content/schema/*.schema.json linguist-generated=true
