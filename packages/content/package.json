{
  "name": "@weddingplanner/content",
  "version": "0.0.0",
  "private": true,
  "description": "Content schemas (Zod), text helpers, and the validate + bake CLI for WeddingPlanner instances.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node src/cli.ts validate",
    "bake": "node src/cli.ts bake",
    "sample-media": "node scripts/generate-sample-media.ts",
    "schema": "node scripts/generate-json-schemas.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
