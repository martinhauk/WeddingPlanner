{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinhauk/WeddingPlanner/main/packages/content/schema/instance.schema.json",
  "title": "WeddingPlanner instance.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sample": {
      "type": "boolean"
    },
    "slug": {
      "type": "string",
      "pattern": "^wed[0-9a-z]{3,8}$"
    },
    "dataLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "swaLocation": {
      "type": "string",
      "enum": [
        "westeurope",
        "centralus",
        "eastus2",
        "westus2",
        "eastasia"
      ]
    },
    "budgetAmount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "alertEmails": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      }
    },
    "adminEmails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      }
    },
    "rsvp": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "deadline",
        "timeZone"
      ],
      "additionalProperties": false
    },
    "environments": {
      "type": "object",
      "properties": {
        "e2e": {
          "type": "object",
          "properties": {
            "features": {
              "type": "object",
              "properties": {
                "rsvp": {
                  "type": "boolean"
                },
                "admin": {
                  "type": "boolean"
                }
              },
              "required": [
                "rsvp",
                "admin"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "features"
          ],
          "additionalProperties": false
        },
        "test": {
          "type": "object",
          "properties": {
            "features": {
              "type": "object",
              "properties": {
                "rsvp": {
                  "type": "boolean"
                },
                "admin": {
                  "type": "boolean"
                }
              },
              "required": [
                "rsvp",
                "admin"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "features"
          ],
          "additionalProperties": false
        },
        "production": {
          "type": "object",
          "properties": {
            "features": {
              "type": "object",
              "properties": {
                "rsvp": {
                  "type": "boolean"
                },
                "admin": {
                  "type": "boolean"
                }
              },
              "required": [
                "rsvp",
                "admin"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "features"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "slug",
    "dataLocation",
    "swaLocation",
    "budgetAmount",
    "alertEmails",
    "adminEmails",
    "rsvp",
    "environments"
  ],
  "additionalProperties": false
}
