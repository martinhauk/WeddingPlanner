{
  "name": "weddingplanner",
  "version": "0.0.0",
  "private": true,
  "description": "Wedding invitation and RSVP site: static one-pager on Azure Static Web Apps with a .NET Functions API.",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present --filter \"!@weddingplanner/e2e\" test",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm storage:up && concurrently --names web,api --prefix-colors cyan,magenta --kill-others-on-fail \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:swa": "pnpm storage:up && node apps/web/swa-config/build-swa-config.ts && concurrently --names web,api,swa --prefix-colors cyan,magenta,yellow --kill-others-on-fail \"pnpm:dev:web\" \"pnpm:dev:api\" \"swa start weddingplanner\"",
    "dev:web": "pnpm --filter @weddingplanner/web --if-present dev",
    "dev:api": "pnpm api:settings && cd apps/api/src/WeddingPlanner.Api && func start --port 7071",
    "api:settings": "node -e \"const d='apps/api/src/WeddingPlanner.Api/';fs.existsSync(d+'local.settings.json')||(fs.copyFileSync(d+'local.settings.sample.json',d+'local.settings.json'),console.log('Created local.settings.json from local.settings.sample.json.'))\"",
    "storage:up": "docker compose up --detach --wait --no-recreate",
    "storage:down": "docker compose down",
    "e2e": "pnpm --filter @weddingplanner/e2e --if-present test",
    "smoke": "pnpm --filter @weddingplanner/e2e --if-present smoke",
    "content:validate": "node packages/content/src/cli.ts validate",
    "content:bake": "node packages/content/src/cli.ts bake"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.1.0",
    "@biomejs/biome": "2.6.8",
    "concurrently": "10.0.7",
    "typescript": "7.0.2"
  }
}
