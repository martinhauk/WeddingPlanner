// Static Web App (Free) with its managed Functions API, and the complete set of API app
// settings. SWA is not offered in germanywestcentral, so it runs in `location` (swaLocation);
// the storage account and App Insights it points at stay in dataLocation (ADR 0006).
//
// Secrets (storage and App Insights connection strings) are built here from `existing`
// references and written straight into the app settings. They are never parameters or outputs.

@description('Static Web App name.')
@minLength(1)
@maxLength(40)
param name string

@description('Region for the Static Web App and its managed functions (swaLocation).')
param location string

@description('Tags applied to the Static Web App.')
param tags object

@description('Name of the storage account (in this resource group) the API uses.')
param storageAccountName string

@description('Name of the Application Insights component (in this resource group).')
param appInsightsName string

@description('Feature flag for the RSVP API (app setting Features__Rsvp).')
param featuresRsvp bool

@description('Feature flag for the admin API (app setting Features__Admin).')
param featuresAdmin bool

@description('RSVP deadline from instance.json (app setting Rsvp__Deadline).')
param rsvpDeadline string

@description('IANA time zone of the RSVP deadline (app setting Rsvp__TimeZone).')
param rsvpTimeZone string

@description('Switches the platform probe GET /api/health/probe on (app setting HealthProbe__Enabled, ADR 0011).')
param healthProbeEnabled bool

resource storageAccount 'Microsoft.Storage/storageAccounts@2026-06-01' existing = {
  name: storageAccountName
}

resource appInsights 'Microsoft.Insights/components@2020-02-02' existing = {
  name: appInsightsName
}

resource staticWebApp 'Microsoft.Web/staticSites@2025-03-01' = {
  name: name
  location: location
  tags: tags
  sku: {
    name: 'Free'
    tier: 'Free'
  }
  properties: {
    // No preview environments: they would share app settings (and data) with this environment.
    stagingEnvironmentPolicy: 'Disabled'
    // staticwebapp.config.json (generated by apps/web/swa-config) is applied on every deploy.
    allowConfigFileUpdates: true
  }
}

// The SWA app settings resource replaces all settings on every deploy, so this is the complete
// set. Names avoid the prefixes SWA reserves (AzureWebJobs*, WEBSITE_*, FUNCTIONS_*, ...), which
// is why the storage connection string is not AzureWebJobsStorage. Every setting has a code
// default in the API.
resource appSettings 'Microsoft.Web/staticSites/config@2025-03-01' = {
  parent: staticWebApp
  name: 'appsettings'
  properties: {
    Storage__ConnectionString: 'DefaultEndpointsProtocol=https;AccountName=${storageAccount.name};AccountKey=${storageAccount.listKeys().keys[0].value};EndpointSuffix=${environment().suffixes.storage}'
    APPLICATIONINSIGHTS_CONNECTION_STRING: appInsights.properties.ConnectionString
    Features__Rsvp: featuresRsvp ? 'true' : 'false'
    Features__Admin: featuresAdmin ? 'true' : 'false'
    Rsvp__Deadline: rsvpDeadline
    Rsvp__TimeZone: rsvpTimeZone
    HealthProbe__Enabled: healthProbeEnabled ? 'true' : 'false'
  }
}

output swaName string = staticWebApp.name
output swaDefaultHostname string = staticWebApp.properties.defaultHostname
