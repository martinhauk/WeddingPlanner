{
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "outputs-should-not-contain-secrets": {
          "level": "error"
        },
        "secure-secrets-in-params": {
          "level": "error"
        },
        "use-secure-value-for-secure-inputs": {
          "level": "error"
        },
        "no-unused-params": {
          "level": "error"
        },
        "use-recent-api-versions": {
          "level": "error"
        }
      }
    }
  }
}
